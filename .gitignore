# 依赖与构建产物
node_modules/
dist/
android/.gradle/
android/build/
android/local.properties
android/.idea/

# 本地配置与运行数据
desktop/.env
desktop/data/received/
desktop/data/outbox/

# 系统
.DS_Store
*.log

# ===== 发布产物与大型二进制（体积大，禁止入库）=====
# 约 682MB：根目录安装包/便携包 ~519MB + deliverables/portable ~163MB
# 警告：这些是构建产物，可从源码重新生成；入库会永久膨胀 git 历史且极难清理
*.zip
*.exe
*.msi

# 便携版打包暂存区（含完整运行时，~258MB）
desktop/portable-staging/
portable-staging/

# 分发补丁副本（与主源码重复，易产生分叉，非源码真值）
desktop-source-patch/
deliverables/portable/

# 安卓安装包（构建产物，可由 gradlew assembleRelease 重新生成；每个 ~22-35MB）
*.apk
*.idsig

# 本地验证/实验暂存区（模拟器实测脚本、截图、APK 探针产物）
.build-tmp/
