# 局域网互传工具 - 电脑端配置示例
# 复制为 .env 并按需修改

# 监听端口（手机/平板通过此端口连接）
PORT=8080

# 绑定地址，0.0.0.0 表示接受局域网内所有网卡的连接
HOST=0.0.0.0

# 电脑端显示名称（出现在手机连接列表里）
DEVICE_NAME=My Computer

# 可选：共享码（6 位以内字符串）。设置后手机必须输入相同共享码才能连接。
# 留空表示不校验。
SHARE_CODE=

# 单文件大小上限（字节）。默认 2GB。
MAX_FILE_SIZE=2147483648

# 数据存储目录（接收的文件、临时压缩包）
DATA_DIR=./data

# 是否自动探测并在日志/界面展示局域网 IP
DISCOVER_LAN_IP=true
