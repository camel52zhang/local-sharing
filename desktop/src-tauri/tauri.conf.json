{
  "productName": "local-sharing",
  "version": "0.1.3",
  "identifier": "com.localsharing.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/bundle-server.mjs",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "resources": {
      "resources/server": "server",
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "shell": { "open": true }
  }
}
